NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

NEXT_PUBLIC_SITE_URL=https://scrmrealestate.com.au

# Public URL for photo and video assets. Leave blank to serve from /public/media in dev.
# In production, set to a Supabase Storage public bucket URL, e.g.:
# https://xxxxx.supabase.co/storage/v1/object/public/media
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── Only needed locally, for `npm run media` (publishing photos and videos) ──
# Settings → API Keys → Secret keys (sb_secret_…). The legacy service_role JWT
# works too. NOT the publishable key — that one can't write.
# Bypasses all security rules: .env.local only, never Vercel, never committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact form email (Resend) ─────────────────────────────────────────────
# Server-side only. Set these in Vercel → Settings → Environment Variables.
# resend.com/api-keys. Without it the form tells people to email instead of
# accepting a message it cannot deliver.
RESEND_API_KEY=

# Where enquiries land. Defaults to SITE.email in src/lib/site.ts.
CONTACT_TO_EMAIL=

# Sender. Must be on a domain verified at resend.com/domains, e.g.
# "SCRM Media <enquiries@scrmrealestate.com.au>". Until a domain is verified
# Resend only allows onboarding@resend.dev, delivered to your own account
# address, which is the default here.
CONTACT_FROM_EMAIL=
